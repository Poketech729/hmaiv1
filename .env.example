# Frontend
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Leave blank in production on Vercel so the app uses same-origin /api.
VITE_BACKEND_URL=

# Backend / Vercel Function
PORT=3000
FRONTEND_URL=http://localhost:5173,https://your-production-domain.vercel.app

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Use the Supabase Session pooler URI for IPv4-friendly connections.
DATABASE_URL=postgresql://postgres.your-project-id:[YOUR-PASSWORD]@aws-REGION.pooler.supabase.com:5432/postgres

# Optional cloud AI providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional local AI for local development only
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_VISION_MODEL=glm-ocr

# OTP delivery
EMAIL_PROVIDER=mock
MESSAGE_PROVIDER=mock

# SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# SMTP / nodemailer
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# AWS SNS
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
